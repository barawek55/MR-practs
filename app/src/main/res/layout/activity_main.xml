<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Маслова К.С. · Т-433901-НТ"
        android:textColor="@color/neon_pink"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        android:fontFamily="monospace"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Калькулятор"
        android:textColor="@color/neon_cyan"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <GridLayout
        android:id="@+id/mainGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alignmentMode="alignMargins"
        android:columnCount="5"
        android:columnOrderPreserved="false"
        android:padding="10dp"
        android:rowCount="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAuthor">

        <EditText
            android:id="@+id/inputA"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_input"
            android:gravity="end|center_vertical"
            android:inputType="numberDecimal|numberSigned"
            android:padding="10dp"
            android:text="15"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/opSymbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_op_badge"
            android:gravity="center"
            android:padding="8dp"
            android:text="+"
            android:textColor="@color/bg_deep"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/inputB"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_input"
            android:gravity="end|center_vertical"
            android:inputType="numberDecimal|numberSigned"
            android:padding="10dp"
            android:text="48"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/outputResult"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="3dp"
            android:background="@drawable/bg_output"
            android:gravity="end|center_vertical"
            android:padding="10dp"
            android:text="= 63.0"
            android:textColor="@color/neon_mint"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:shadowColor="@color/neon_mint"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <Button
            android:id="@+id/keyPlus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowSpan="2"
            android:layout_rowWeight="2"
            android:layout_column="0"
            android:layout_columnSpan="1"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_primary"
            android:text="+"
            android:textColor="@color/neon_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/keyMinus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="3dp"
            android:background="@drawable/btn_primary"
            android:text="-"
            android:textColor="@color/neon_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/keyDivide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="3dp"
            android:background="@drawable/btn_primary"
            android:text="/"
            android:textColor="@color/neon_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/keyTimes"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnSpan="4"
            android:layout_columnWeight="4"
            android:layout_margin="3dp"
            android:background="@drawable/btn_accent"
            android:text="*"
            android:textColor="#031A18"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/keyReset"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnSpan="5"
            android:layout_columnWeight="5"
            android:layout_margin="3dp"
            android:background="@drawable/btn_danger"
            android:text="C"
            android:textColor="#FFF1F1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="monospace" />

    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
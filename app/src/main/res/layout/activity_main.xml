<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">


        <Button
            android:id="@+id/btnOne"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_1"
            android:text="TOAST · 2 сек"
            android:textAlignment="center"
            android:textColor="@color/cyber_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnTwo"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_2"
            android:text="TOAST · 3.5 сек"
            android:textColor="@color/cyber_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnThree"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_3"
            android:text="ДИАЛОГ · ДА / ОТМЕНА"
            android:textColor="@color/cyber_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnFour"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_4"
            android:text="ТЕСТ · ПЛАНЕТЫ"
            android:textColor="@color/cyber_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Маслова К.С. · Т-433901-НТ"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"/>

    </LinearLayout>
</ScrollView>
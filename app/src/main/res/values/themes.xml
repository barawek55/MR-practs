<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.pract3" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorSecondary">@color/neon_pink</item>
        <item name="android:statusBarColor">@color/cyber_dark</item>
        <item name="android:navigationBarColor">@color/cyber_dark</item>
        <item name="android:windowBackground">@drawable/bg_gradient</item>

        <item name="alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <style name="AppDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/cyber_panel</item>
        <item name="colorOnSurface">@color/text_light</item>
        <item name="colorPrimary">@color/neon_cyan</item>

        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/text_light</item>
        <item name="android:background">@color/cyber_panel</item>
    </style>

</resources>